# Local development defaults to SQLite and visibly labeled Mock AI.
# Set AI_PROVIDER=openai and OPENAI_API_KEY to use the OpenAI API.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///resuscitation-local.sqlite3
DISPLAY_TIMEZONE=America/Chicago
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_TIMEOUT_SECONDS=30
PATIENT_FIXTURE_DIR=app/fixtures/patients
SESSION_COOKIE_SECURE=false
