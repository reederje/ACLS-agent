{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["patient_id", "display_name", "scenario_reference_time", "demographics", "suggested_workflow", "domains"],
  "properties": {
    "patient_id": {"type": "string", "pattern": "^SYN-[AP][0-9]{2}$"},
    "display_name": {"type": "string", "minLength": 1},
    "scenario_reference_time": {"type": "string", "format": "date-time"},
    "demographics": {
      "type": "object",
      "required": ["age_display", "age_years", "population", "weight_kg", "weight_provenance", "code_status"],
      "properties": {
        "age_display": {"type": "string"},
        "age_years": {"type": "number", "minimum": 0},
        "population": {"enum": ["adult", "pediatric"]},
        "weight_kg": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "weight_provenance": {"enum": ["measured", "historical", "caregiver-reported", "estimated", "unknown"]},
        "code_status": {"type": "string"}
      },
      "additionalProperties": true
    },
    "suggested_workflow": {"enum": ["cardiac_arrest", "bradycardia_with_pulse", "tachycardia_with_pulse"]},
    "domains": {
      "type": "object",
      "required": ["encounters", "problems", "medications", "allergies", "weights", "code_status", "vitals", "labs", "procedures", "imaging", "ecg", "notes"],
      "properties": {
        "encounters": {"$ref": "#/$defs/domain"},
        "problems": {"$ref": "#/$defs/domain"},
        "medications": {"$ref": "#/$defs/domain"},
        "allergies": {"$ref": "#/$defs/domain"},
        "weights": {"$ref": "#/$defs/domain"},
        "code_status": {"$ref": "#/$defs/domain"},
        "vitals": {"$ref": "#/$defs/domain"},
        "labs": {"$ref": "#/$defs/domain"},
        "procedures": {"$ref": "#/$defs/domain"},
        "imaging": {"$ref": "#/$defs/domain"},
        "ecg": {"$ref": "#/$defs/domain"},
        "notes": {"$ref": "#/$defs/domain"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "required": ["availability", "records"],
      "properties": {
        "availability": {"enum": ["available", "empty", "unavailable"]},
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "observed_offset_days", "available_offset_days", "finding"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "observed_offset_days": {"type": "integer"},
              "available_offset_days": {"type": "integer"},
              "ongoing": {"type": "boolean"},
              "finding": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
